{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["react", "react-dom"]
  },
  "include": [
    "src/gui/renderer/**/*.ts",
    "src/gui/renderer/**/*.tsx",
    "src/gui/api-types.ts",
    "src/domain/**/*.ts",
    "src/application/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
